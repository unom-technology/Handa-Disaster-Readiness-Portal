# Copy this file to ".env" and adjust as needed.
# The app runs with sensible defaults even if you leave everything unset.

# --- Server ---
PORT=3000
# Any long random string. Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Default map location (shown before a user sets an address) ---
# Defaults to Manila, Philippines.
DEFAULT_LAT=14.5995
DEFAULT_LNG=120.9842
DEFAULT_PLACE=Manila, Philippines

# --- Seed admin account (created the first time the DB is built) ---
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@handa.local
ADMIN_PASSWORD=Admin@123

# --- Nominatim (OpenStreetMap geocoding) ---
# Their usage policy asks for a contact in the User-Agent. Optional for light use.
NOMINATIM_CONTACT=

# --- Email (Nodemailer) ---
# Leave blank to auto-create a free Ethereal test inbox (preview links are logged
# to the console). To send real email, fill these in (e.g. a Gmail App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Handa Readiness Portal <no-reply@handa.local>"
