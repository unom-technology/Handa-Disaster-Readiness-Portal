<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="card auth-card">
  <h1>Create account</h1>
  <form action="/register" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="field">
      <label for="name">Full name</label>
      <input type="text" id="name" name="name" value="<%= form.name || '' %>" required autofocus />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= form.email || '' %>" required />
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required minlength="6" />
      <div class="hint">At least 6 characters.</div>
    </div>
    <div class="field">
      <label for="address">Home address <span class="muted">(optional)</span></label>
      <input type="text" id="address" name="address" value="<%= form.address || '' %>"
             placeholder="e.g. Barangay Holy Spirit, Quezon City" />
      <div class="hint">Used to localise your weather, quake and evacuation info.</div>
    </div>
    <button type="submit" class="btn" style="width:100%">Sign up</button>
  </form>
  <p class="center-text small muted" style="margin-top:16px">
    Already registered? <a href="/login">Log in</a>.
  </p>
</div>

<%- include('partials/foot') %>
