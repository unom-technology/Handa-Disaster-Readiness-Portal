<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-head"><h1><%= title %></h1></div>

<div class="card form-card">
  <form action="<%= action %>" method="<%= method %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" value="<%= report.title || '' %>"
             placeholder="e.g. Waist-deep flooding on Main St." required />
    </div>

    <div class="form-row">
      <div class="field">
        <label for="type">Type</label>
        <select id="type" name="type" required>
          <% types.forEach(function(t){ %>
            <option value="<%= t %>" <%= report.type === t ? 'selected' : '' %>><%= t %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="severity">Severity</label>
        <select id="severity" name="severity" required>
          <% severities.forEach(function(s){ %>
            <option value="<%= s %>" <%= report.severity === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="field">
      <label for="address">Location / address</label>
      <input type="text" id="address" name="address" value="<%= report.address || '' %>"
             placeholder="Barangay, street, landmark — used to place it on the map" />
      <div class="hint">We convert this to map coordinates via OpenStreetMap.</div>
    </div>

    <div class="field">
      <label for="description">Description</label>
      <textarea id="description" name="description" placeholder="What is happening? Any people at risk?"><%= report.description || '' %></textarea>
    </div>

    <div class="btn-row">
      <button type="submit" class="btn">Save report</button>
      <a href="/reports" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>
