<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-head"><h1><%= title %></h1></div>

<div class="card form-card">
  <form action="<%= action %>" method="<%= method %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="field">
      <label for="name">Center name</label>
      <input type="text" id="name" name="name" value="<%= center.name || '' %>"
             placeholder="e.g. Barangay Hall Multi-purpose Court" required />
    </div>

    <div class="field">
      <label for="address">Address</label>
      <input type="text" id="address" name="address" value="<%= center.address || '' %>"
             placeholder="Street, Barangay, City" required />
      <div class="hint">Geocoded via OpenStreetMap to place it on the map.</div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="capacity">Capacity</label>
        <input type="number" id="capacity" name="capacity" min="0" value="<%= center.capacity || 0 %>" />
      </div>
      <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
          <% statuses.forEach(function(s){ %>
            <option value="<%= s %>" <%= center.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="field">
      <label for="contact">Contact number <span class="muted">(optional)</span></label>
      <input type="text" id="contact" name="contact" value="<%= center.contact || '' %>" placeholder="(02) 8XXX-XXXX" />
    </div>

    <div class="field">
      <label for="notes">Notes <span class="muted">(optional)</span></label>
      <textarea id="notes" name="notes" placeholder="Facilities, pet policy, medical team…"><%= center.notes || '' %></textarea>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="lat">Latitude <span class="muted">(optional, overrides address)</span></label>
        <input type="text" id="lat" name="lat" value="<%= center.lat != null ? center.lat : '' %>" placeholder="14.5995" />
      </div>
      <div class="field">
        <label for="lng">Longitude <span class="muted">(optional)</span></label>
        <input type="text" id="lng" name="lng" value="<%= center.lng != null ? center.lng : '' %>" placeholder="120.9842" />
      </div>
    </div>

    <div class="btn-row">
      <button type="submit" class="btn">Save center</button>
      <a href="/centers" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>
